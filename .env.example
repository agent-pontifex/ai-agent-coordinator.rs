COORDINATOR_API_TOKEN=replace-with-a-long-random-token
# PostgreSQL runtime connection. Production should inject this from the secret manager.
AI_AGENT_COORDINATOR_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_agent_coordinator
# dpm uses a separate non-production server/database for materialization and verification.
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Legacy/default secret for issue, pull-request, and workflow-run events.
GITHUB_WEBHOOK_SECRET=replace-with-a-github-webhook-secret
# Multi-organization push ingestion uses a unique secret per organization.
# Map organization names to environment-variable names; never put secret values here.
GITHUB_WEBHOOK_ORG_SECRET_ENVS=sonus-auris=GITHUB_WEBHOOK_SECRET_SONUS_AURIS,daedalus-fab=GITHUB_WEBHOOK_SECRET_DAEDALUS_FAB
GITHUB_WEBHOOK_SECRET_SONUS_AURIS=
GITHUB_WEBHOOK_SECRET_DAEDALUS_FAB=
# Push processing is fail-closed until explicitly enabled with an allowlist.
GITHUB_AUTO_ENQUEUE_PUSHES=false
GITHUB_PUSH_ALLOWED_REPOSITORIES=sonus-auris/sonus-auris-site.web,daedalus-fab/daedalus-clients
GITHUB_PUSH_DEFAULT_BRANCHES=sonus-auris/sonus-auris-site.web=main,daedalus-fab/daedalus-clients=main
# Linear delivery is a separate protected phase. It is disabled and dry-run by default.
LINEAR_DELIVERY_ENABLED=false
LINEAR_DELIVERY_DRY_RUN=true
LINEAR_API_URL=https://api.linear.app/graphql
# Personal API keys use api_key; OAuth access tokens use bearer.
LINEAR_API_AUTH_SCHEME=api_key
# Secret-manager/environment only. Never pass this value as a CLI flag.
LINEAR_API_TOKEN=
LINEAR_TEAM_KEY=DEN
# Exact GitHub organization to Linear project-name map.
LINEAR_PROJECT_NAMES=sonus-auris=github.com/sonus-auris,daedalus-fab=github.com/daedalus-fab
# Optional exact per-org state IDs for closing directives.
LINEAR_COMPLETED_STATE_IDS=sonus-auris=replace-with-completed-state-uuid,daedalus-fab=replace-with-completed-state-uuid
LINEAR_REQUEST_TIMEOUT_MS=10000
LINEAR_MAX_RESPONSE_BYTES=262144
LINEAR_MAX_RETRIES=3
LINEAR_MIN_ORG_INTERVAL_MS=100
# Email attention is fail-closed and read-only. Keep disabled until native mailbox
# connector and notification adapters are deployed and a manual preview is reviewed.
EMAIL_ATTENTION_ENABLED=false
EMAIL_ATTENTION_TIMEZONE=America/New_York
EMAIL_ATTENTION_WEEKDAYS=mon,tue,wed,thu,fri
EMAIL_ATTENTION_LOCAL_HOUR=9
EMAIL_ATTENTION_LOCAL_MINUTE=0
# Runtime-only JSON. Use aliases, not private mailbox addresses. The connector
# endpoints must wrap native Gmail or Microsoft Graph read APIs.
EMAIL_ATTENTION_SOURCES_JSON='[{"id":"primary-gmail","provider":"gmail","endpoint":"https://gmail-connector.internal/v1/read-attention-window","token_env":"PRIMARY_GMAIL_CONNECTOR_TOKEN"},{"id":"work-outlook","provider":"outlook","endpoint":"https://outlook-connector.internal/v1/read-attention-window","token_env":"WORK_OUTLOOK_CONNECTOR_TOKEN"}]'
PRIMARY_GMAIL_CONNECTOR_TOKEN=
WORK_OUTLOOK_CONNECTOR_TOKEN=
EMAIL_ATTENTION_NOTIFICATION_URL=https://notification-adapter.internal/v1/email-attention
EMAIL_ATTENTION_NOTIFICATION_TOKEN_ENV=EMAIL_ATTENTION_NOTIFICATION_TOKEN
EMAIL_ATTENTION_NOTIFICATION_TOKEN=
EMAIL_ATTENTION_REQUEST_TIMEOUT_MS=15000
EMAIL_ATTENTION_MAX_RESPONSE_BYTES=524288
EMAIL_ATTENTION_MAX_MESSAGES_PER_SOURCE=200
EMAIL_ATTENTION_MAX_NOTIFICATIONS_PER_RUN=50
EMAIL_ATTENTION_REMINDER_INTERVAL_HOURS=24
EMAIL_ATTENTION_LEASE_SECONDS=3600
EMAIL_ATTENTION_PENDING_RETRY_LIMIT=20
EMAIL_ATTENTION_USER_AGENT=ai-agent-coordinator-email-attention
# Repository creation is fail-closed. Leave disabled until a dry run is reviewed.
GITHUB_REPOSITORY_ADMIN_ENABLED=false
# Use a short-lived GitHub App installation token with repository Administration: write.
GITHUB_REPOSITORY_ADMIN_TOKEN=
# Comma-separated exact organization allowlist, for example declarative-migrations,rust-ssr-demos
GITHUB_REPOSITORY_ADMIN_ALLOWED_ORGS=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_ALLOWED_HOSTS=api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_API_USER_AGENT=ai-agent-coordinator
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
RUST_LOG=ai_agent_coordinator=info,tower_http=info
